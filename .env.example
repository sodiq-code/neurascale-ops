# NeuroScale Ops — Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.

# ── AI Model ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── UiPath Integration ────────────────────────────────────────────────────────
UIPATH_ORCHESTRATOR_URL=https://cloud.uipath.com
UIPATH_TENANT=your-tenant
UIPATH_CLIENT_ID=your-client-id
UIPATH_CLIENT_SECRET=your-client-secret
MAESTRO_WEBHOOK_URL=https://cloud.uipath.com/yourorg/yourtenant/orchestrator_/api/maestro/webhook/...

# ── ArgoCD ────────────────────────────────────────────────────────────────────
ARGOCD_SERVER=localhost:8080
ARGOCD_TOKEN=your-argocd-token
ARGOCD_APP_NAME=neurascale-ops

# ── OpenCost (FinOps) ─────────────────────────────────────────────────────────
OPENCOST_URL=http://localhost:9090

# ── Kubernetes ────────────────────────────────────────────────────────────────
KUBECONFIG=~/.kube/config
# or leave unset for in-cluster config (when running inside K8s)

# ── Notifications ─────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
ONCALL_EMAIL=oncall@yourcompany.com

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to simulate K8s/OpenCost/ArgoCD calls without a real cluster
DEMO_MODE=true

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:8501
